---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
const icons = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Unknown icon: ${name}`);
---

<span class:list={['icon', className]} aria-hidden="true" set:html={svg} />
