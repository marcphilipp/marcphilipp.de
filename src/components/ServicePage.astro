---
import Layout from '../layouts/Layout.astro';
import CtaBanner from './CtaBanner.astro';
import { ChevronRight, type AstroComponent } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { md } from '../data/markdown';
import { translations, type Lang } from '../data/translations';

interface Props {
  title: string;
  /** Lead paragraph, also used as the meta description. */
  lead: string;
  /** Category icon from the services overview, shown large next to the intro; brand icons are passed by name. */
  icon: string | AstroComponent;
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  blocks: {
    title: string;
    text: string;
    items?: string[];
    /** Render items as a numbered list (e.g. process steps). */
    ordered?: boolean;
    link?: { href: string; text: string };
    /** Span two rows in the grid (for tall blocks). */
    tall?: boolean;
  }[];
}
const { title, lead, icon: IconComponent, lang, alternates, blocks } = Astro.props;
const t = translations[lang].services;
---

<Layout title={title} description={lead} lang={lang} activeNav="services" alternates={alternates}>
  {typeof IconComponent === 'string' ? (
    <BrandIcon name={IconComponent} class="service-icon" />
  ) : (
    <IconComponent class="service-icon" />
  )}
  <p class="lead">{lead}</p>
  <slot />

  <h2>{t.howICanHelp}</h2>
  <div class="services-grid">
    {blocks.map((block) => (
      <div class:list={['service-block', 'well', { tall: block.tall }]}>
        <div>
          <h3>{block.title}</h3>
          {block.text.split(/\n\s*\n/).map((paragraph) => <p set:html={md(paragraph)} />)}
          {block.items && block.ordered && (
            <ol>
              {block.items.map((item) => <li set:html={md(item)} />)}
            </ol>
          )}
          {block.items && !block.ordered && (
            <ul>
              {block.items.map((item) => <li set:html={md(item)} />)}
            </ul>
          )}
          {block.link && (
            <p>
              <a href={block.link.href} class="btn btn-default">
                {block.link.text} <ChevronRight />
              </a>
            </p>
          )}
        </div>
      </div>
    ))}
  </div>

  <CtaBanner lang={lang} />
</Layout>
