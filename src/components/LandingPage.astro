---
import { Image } from 'astro:assets';
import { Mail, Mic } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../data/translations';
import avatar from '../assets/avatar.jpg';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  roles: string[];
  labels: { contact: string; talks: string; projects: string; cv: string };
  links: { contact: string; talks: string };
  availability: { label: string; href: string };
}
const { lang, alternates, roles, labels, links, availability } = Astro.props;
---

<Layout lang={lang} alternates={alternates} bodyClass="landing-page" showJumbotron={false}>
  <Image src={avatar} alt="Marc Philipp" class="img-circle" width={215} height={215} densities={[1, 2, 3]} loading="eager" fetchpriority="high" />

  <h1>Marc Philipp</h1>

  <p><a class="availability-pill" href={availability.href}>{availability.label}</a></p>

  <ul class="lead list-unstyled">
    {roles.map((role) => <li>{role}</li>)}
  </ul>

  <div class="btn-group" role="group" style="min-width: 200px">
    <a class="btn btn-success" href={links.contact} role="button"><Mail /> {labels.contact}</a>
    <a class="btn btn-default" href={links.talks} role="button"><Mic /> <span class="hidden-xs">{labels.talks}</span></a>
    <a class="btn btn-default" href="https://github.com/marcphilipp" role="button"><BrandIcon name="github" /> <span class="hidden-xs">{labels.projects}</span></a>
    <a class="btn btn-default" href="https://www.linkedin.com/in/marcphilipp" role="button"><BrandIcon name="linkedin" /> <span class="hidden-xs">{labels.cv}</span></a>
  </div>
</Layout>
