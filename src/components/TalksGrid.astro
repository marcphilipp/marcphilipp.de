---
import { Image } from 'astro:assets';
import { CirclePlay, FileCode, Presentation, TextAlignStart } from '@lucide/astro';
import { translations, formatDate, type Lang } from '../data/translations';
import talks from '../data/talks.json';
import placeholder from '../assets/slide_placeholder.png';

const slideImages = import.meta.glob<{ default: ImageMetadata }>('../assets/talks/**/*', {
  eager: true,
});

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];

interface Talk {
  title: string;
  event: string;
  city?: string;
  country?: string;
  date: string;
  date_max?: string;
  'co-speakers'?: string;
  abstract?: string;
  slides?: string;
  slideImage?: string;
  code?: string;
  youtube?: string;
  recording?: string;
}

const byYear = new Map<string, Talk[]>();
for (const talk of [...(talks as Talk[])].reverse()) {
  const year = talk.date.slice(0, 4);
  byYear.set(year, [...(byYear.get(year) ?? []), talk]);
}

function location(talk: Talk): string | undefined {
  if (!talk.city) return undefined;
  const city = t.cities[talk.city] ?? talk.city;
  if (talk.country && talk.country !== lang) {
    return `${city}, ${t.countries[talk.country] ?? talk.country}`;
  }
  return city;
}
---

{[...byYear.entries()].map(([year, yearTalks]) => (
  <>
    <h2>{year}</h2>
    <div class="talks-grid">
      {yearTalks.map((talk) => {
        const image = talk.slideImage
          ? slideImages[`../assets/talks/${talk.slideImage}`].default
          : placeholder;
        const links = [
          talk.abstract && { href: talk.abstract, icon: TextAlignStart, label: t.talks.abstract },
          talk.slides && { href: talk.slides, icon: Presentation, label: t.talks.slides },
          talk.code && { href: talk.code, icon: FileCode, label: t.talks.code },
          talk.youtube && {
            href: `https://www.youtube.com/watch?v=${talk.youtube}`,
            icon: CirclePlay,
            label: t.talks.recording,
          },
          talk.recording && { href: talk.recording, icon: CirclePlay, label: t.talks.recording },
        ].filter((link) => !!link);
        return (
          <div class="talk">
            {talk.slides ? (
              <a href={talk.slides}><Image src={image} alt="" width={450} densities={[1, 2]} /></a>
            ) : (
              <Image src={image} alt="" width={450} densities={[1, 2]} />
            )}
            <div class="caption">
              <p>
                <strong>
                  {talk.title}
                  {talk['co-speakers'] && ` (${t.talks.with} ${talk['co-speakers']})`}
                </strong>
              </p>
              <p>
                <em>{talk.event}</em><br />
                {location(talk) && <>{location(talk)}<br /></>}
                {formatDate(new Date(talk.date), lang)}
                {talk.date_max && ` - ${formatDate(new Date(talk.date_max), lang)}`}
              </p>
              <ul class="list-inline talk-links">
                {links.map((link) => (
                  <li>
                    <a href={link.href}><link.icon /> {link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        );
      })}
    </div>
  </>
))}
