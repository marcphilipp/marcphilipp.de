---
import { Rss } from '@lucide/astro';
import BlogIndex from '../../components/BlogIndex.astro';
import LanguageHint from '../../components/LanguageHint.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog" lang="en" activeNav="blog" alternates={{ en: '/en/blog/', de: '/de/blog/' }}>
  <a slot="header-actions" href="/feed.xml" class="btn btn-default"><Rss /> RSS</a>
  <BlogIndex lang="en">
    <LanguageHint>
      These are my blog posts in English. If you speak German, be sure to check out
      my <a href="/de/blog/">German posts</a>, too.
    </LanguageHint>
  </BlogIndex>
</Layout>
