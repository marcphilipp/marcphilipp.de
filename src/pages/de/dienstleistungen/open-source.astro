---
import { GitPullRequestArrow, Megaphone, Scale, Users } from '@lucide/astro';
import ServicePage from '../../../components/ServicePage.astro';

const blocks = [
  {
    icon: Users,
    title: 'Contribution-Programm',
    text: 'Ich kann Ihnen dabei helfen, ein Programm aufzusetzen, das es Ihren Entwickler:innen ermöglicht, erfolgreich zu den Open-Source-Projekten beizutragen, auf die Ihr Unternehmen angewiesen ist.',
  },
  {
    icon: Scale,
    title: 'Open-Sourcing-Richtlinien',
    text: 'Richtlinien für die Veröffentlichung eigener Bibliotheken und Frameworks sind aus Compliance-Gründen unverzichtbar und müssen mit Ihrer Rechtsabteilung abgestimmt sein.',
  },
  {
    icon: Megaphone,
    title: 'Sichtbarkeit & PR-Strategie',
    text: 'Die beste Open-Source-Strategie bringt nichts, wenn keiner davon weiß. ' +
        'Gemeinsam bauen wir eine PR-Strategie rund um Ihre Open-Source-Arbeit auf, mit Engineering-Blog und Social-Media-Präsenz.',
  },
];
---

<ServicePage
  title="Open Source"
  lead="Definieren Sie eine erfolgreiche Open-Source-Strategie und setzen Sie sie in die Praxis um!"
  icon={GitPullRequestArrow}
  lang="de"
  alternates={{ en: '/en/services/open-source/', de: '/de/dienstleistungen/open-source/' }}
  blocks={blocks}
>
  <p>
    Open Source ist ein wesentlicher Bestandteil moderner Softwareentwicklung.
    Ich helfe Ihnen, ein Programm aufzubauen, mit dem Ihre Organisation zu Open Source
    beiträgt, selbst Software veröffentlicht und nachhaltig davon profitiert.
  </p>
</ServicePage>
