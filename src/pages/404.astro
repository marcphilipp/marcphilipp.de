---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" lang="en">
  <small slot="subtitle">HTTP 404</small>
  <div class="alert alert-danger" role="alert">
    <Icon name="triangle-exclamation" /> Sorry, this page does not exist.
  </div>

  <p><a href="/" class="btn btn-lg btn-success">Start Over <Icon name="chevron-right" /></a></p>
</Layout>
