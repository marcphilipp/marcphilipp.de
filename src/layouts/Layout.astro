---
import { Copyright, Languages, Menu, Moon, Sun, X } from '@lucide/astro';
import BrandIcon from '../components/BrandIcon.astro';
import { translations, type Lang } from '../data/translations';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  /** URL of this page in each language it exists in (including the current one). */
  alternates?: Partial<Record<Lang, string>>;
  /** Which nav item to highlight. */
  activeNav?: 'services' | 'blog' | 'talks' | 'contact';
  bodyClass?: string;
  showJumbotron?: boolean;
  noindex?: boolean;
}
const defaultDescription = {
  en: 'Marc Philipp — software engineer, JUnit team lead, Java Champion. Independent consultant on JUnit, Gradle, and software delivery performance.',
  de: 'Marc Philipp — Software Engineer, JUnit Team Lead, Java Champion und Konferenzsprecher. Selbständiger Berater zu JUnit, Gradle und Software Delivery Performance.',
};

const {
  title,
  lang,
  description: rawDescription = defaultDescription[lang],
  alternates = {},
  activeNav,
  bodyClass,
  showJumbotron = true,
  noindex = false,
} = Astro.props;

// Search engines truncate snippets around 160 characters.
const description =
  rawDescription.length > 160
    ? rawDescription.slice(0, 157).replace(/\s+\S*$/, '') + '…'
    : rawDescription;

const siteTitle = 'Marc Philipp';
const fullTitle = title ? `${title} • ${siteTitle}` : siteTitle;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const nav = {
  en: [
    { title: 'Services', href: '/en/services/', key: 'services' },
    { title: 'Blog', href: '/en/blog/', key: 'blog' },
    { title: 'Talks', href: '/en/talks/', key: 'talks' },
    { title: 'Contact', href: '/en/contact/', key: 'contact' },
  ],
  de: [
    { title: 'Dienstleistungen', href: '/de/dienstleistungen/', key: 'services' },
    { title: 'Blog', href: '/de/blog/', key: 'blog' },
    { title: 'Vorträge', href: '/de/vortraege/', key: 'talks' },
    { title: 'Kontakt', href: '/de/kontakt/', key: 'contact' },
  ],
}[lang];

const socialLinks = [
  { key: 'github', href: 'https://github.com/marcphilipp', title: 'marcphilipp on GitHub' },
  { key: 'codeberg', href: 'https://codeberg.org/marcphilipp', title: 'marcphilipp on Codeberg' },
  { key: 'linkedin', href: 'https://www.linkedin.com/in/marcphilipp', title: 'Marc Philipp on LinkedIn' },
  { key: 'mastodon', href: 'https://chaos.social/@marcphilipp', title: '@marcphilipp@chaos.social on Mastodon', me: true },
  { key: 'bluesky', href: 'https://bsky.app/profile/marcphilipp.de', title: '@marcphilipp.de on Bluesky', me: true },
];

const langs: Lang[] = ['en', 'de'];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marc Philipp',
  url: Astro.site?.href,
  jobTitle: 'JUnit Team Lead and Independent Engineering Consultant',
  sameAs: socialLinks.map((link) => link.href),
});

const privacy = {
  en: { title: 'Privacy Policy', href: '/en/privacy-policy/' },
  de: { title: 'Datenschutz', href: '/de/datenschutz/' },
}[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored theme override before first paint to avoid flashing
      try {
        const theme = localStorage.getItem('theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:image" content={new URL('/img/social-preview-image.png', Astro.site)} />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/feed.xml" />

    <link rel="apple-touch-icon" sizes="57x57" href="/favicon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/favicon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/favicon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/favicon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/favicon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/favicon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/favicon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/favicon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/favicon-144x144.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16202f" media="(prefers-color-scheme: dark)" />

    {langs
      .filter((l) => alternates[l])
      .map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l]!, Astro.site)} />)}

    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body class={bodyClass}>
    <header class="site-header">
      <nav class="navbar">
        <div class="container">
          <a class="navbar-brand" href={translations[lang].index}>{siteTitle}</a>
          <input type="checkbox" id="nav-toggle" class="nav-toggle-input" autocomplete="off" aria-label="Toggle navigation" />
          <label for="nav-toggle" class="nav-toggle">
            <Menu class="menu-open" />
            <X class="menu-close" />
          </label>
          <div class="navbar-links">
          <ul class="navbar-main">
            {nav.map((item) => (
              <li class:list={{ active: item.key === activeNav }}>
                <a href={item.href}>{item.title}</a>
              </li>
            ))}
          </ul>
          <ul class="navbar-right">
            <li class="language-menu">
              <details>
                <summary aria-label={`${lang === 'en' ? 'Language' : 'Sprache'}: ${translations[lang].name}`}><Languages /> {translations[lang].name}</summary>
                <ul class="dropdown-menu">
                  {langs.map((l) =>
                    l === lang ? (
                      <li class="active"><a href={Astro.url.pathname} lang={l} hreflang={l}>{translations[l].name}</a></li>
                    ) : alternates[l] ? (
                      <li><a href={alternates[l]} lang={l} hreflang={l}>{translations[l].name}</a></li>
                    ) : (
                      <li class="disabled"><span lang={l}>{translations[l].name}</span></li>
                    )
                  )}
                </ul>
              </details>
            </li>
            <li>
              <button
                type="button"
                class="theme-toggle"
                aria-label={lang === 'en' ? 'Toggle dark mode' : 'Dunkelmodus umschalten'}
              >
                <Moon class="moon" />
                <Sun class="sun" />
              </button>
            </li>
          </ul>
          </div>
        </div>
      </nav>
    </header>

    {showJumbotron && (
      <div class="jumbotron">
        <div class="container">
          <h1>{title} <slot name="subtitle" /></h1>
          <slot name="header-actions" />
        </div>
      </div>
    )}

    <div id="content" class="container">
      <slot />
    </div>

    <footer>
      <div class="container">
        <ul class="footer-nav">
          <li class:list={{ active: Astro.url.pathname === '/de/impressum/' }}>
            <a href="/de/impressum/">{lang === 'en' ? 'Legal' : 'Impressum'}</a>
          </li>
          <li class:list={{ active: Astro.url.pathname === privacy.href }}>
            <a href={privacy.href}>{privacy.title}</a>
          </li>
        </ul>
        <ul class="footer-social">
          {socialLinks.map((link) => (
            <li class:list={['social', link.key]}>
              <a rel={link.me ? 'me' : undefined} href={link.href} title={link.title}>
                <BrandIcon name={link.key} />
              </a>
            </li>
          ))}
        </ul>
        <p class="text-muted"><Copyright /> {new Date().getFullYear()} {siteTitle}</p>
      </div>
    </footer>

    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
